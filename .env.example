# Postgres
DATABASE_URL="postgresql://toucan:toucan@127.0.0.1:5432/toucan?schema=public"

# Public URL (no trailing slash)
APP_URL="http://localhost:3000"

# next-auth / calendar config encryption
AUTH_SECRET=""
CALENDAR_SECRETS_KEY=""

# Mail (Proton SMTP, or any SMTP). Optional SMTP_URL instead of host/user/pass.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Toucan 121 <notifications@example.com>"

# Account mail (password reset, confirm email). Falls back to SMTP_* if unset.
AUTH_SMTP_USER=""
AUTH_SMTP_PASS=""
AUTH_SMTP_FROM="Toucan 121 <no-reply@example.com>"

# Host calendar OAuth (optional)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional video link base
JITSI_BASE_URL=""
